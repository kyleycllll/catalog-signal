{
  "run_id": "esci-us-heldout-v1",
  "output_root": "reports/experiments",
  "seed": 42,
  "manifest": "data/manifests/esci_split_manifest.json",
  "catalog": "data/processed/esci_us_products.parquet",
  "labels": "data/esci/labels.parquet",
  "dense_index": "data/indexes/esci_us_minilm.faiss",
  "bm25_index": "data/indexes/esci_us_bm25",
  "retrieval": {
    "systems": [
      "bm25",
      "dense",
      "hybrid"
    ],
    "candidate_ks": [
      10,
      40
    ],
    "embedding_model": "sentence-transformers/all-MiniLM-L6-v2",
    "rrf_k": 60,
    "fusion_depth": 1000,
    "test_max_queries": null,
    "bootstrap_samples": 2000,
    "selection": {
      "split": "validation",
      "max_queries": null,
      "metric": "recall_at_40",
      "rule": "Pre-registered: the system with the highest mean validation Recall@40 over known E/S positives supplies the fixed candidate sets for reranking (ties resolved by list order). RRF k=60 is the implemented default and is not tuned."
    }
  }
}
